{
  "version": 2,
  "name": "flowmonkey-remotion-vfx",
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ],
  "functions": {
    "api/render.ts": {
      "memory": 3008,
      "maxDuration": 60
    },
    "api/preview.ts": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "env": {
    "REMOTION_APP_REGION": "asia-southeast1",
    "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD": "true"
  }
}
